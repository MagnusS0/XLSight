<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>High-performance streaming Excel workbook reading and analysis library for .NET 10</Description>
    <!-- XML docs — required for NuGet consumers and enables IDE0005 on build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AOT and trimming compatibility — enforced from day one -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
</Project>
