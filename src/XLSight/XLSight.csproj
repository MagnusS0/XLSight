<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>High-performance streaming Excel workbook reading and analysis library for .NET 10</Description>
    <!-- XML docs — required for NuGet consumers and enables IDE0005 on build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AOT and trimming compatibility — enforced from day one -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>XLSight</PackageId>
    <Version>0.8.3</Version>
    <Authors>Magnus</Authors>
    <Description>High-performance streaming Excel (.xlsx, .xlsm, .xlsb) reader and analyzer for .NET 10. Zero dependencies, AOT-compatible, ZipArchive + XmlReader based.</Description>
    <PackageTags>excel;xlsx;xlsm;xlsb;spreadsheet;openxml;dotnet;streaming;analysis;vba</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MagnusS0/XLSight</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MagnusS0/XLSight</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
